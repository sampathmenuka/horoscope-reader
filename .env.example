# URL of the FastAPI calculation service (backend/main.py)
BACKEND_URL=http://127.0.0.1:8000

# Optional: Postgres for saved profiles and the daily cache. The value below matches
# docker-compose.yml. Without it, profiles stay in the browser and the cache uses disk.
DATABASE_URL=postgresql://handahana:handahana@127.0.0.1:5433/handahana

# Optional: enables Gemini-written readings (key from https://aistudio.google.com/apikey).
# Either name works. Without a key, the built-in rule-based engine writes the reading.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Force the rule-based engine even when a key is set:
# PREDICTION_ENGINE=rules
