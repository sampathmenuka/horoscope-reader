# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# env files: real secrets stay local, the template is committed
.env*
!.env.example

# secrets and certificates
*.pem
*.key

# vercel
.vercel

# typescript
*.tsbuildinfo

# python backend
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# daily horoscope cache (lib/dailyCache.ts)
.cache/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# operating systems
.DS_Store
Thumbs.db
Desktop.ini

# claude code personal settings
.claude/settings.local.json
